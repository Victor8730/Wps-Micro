{
  "name": "webpagestudio/wps-micro",
  "description": "Lightweight PHP framework for building web applications",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Victor Galiuzov",
      "email": "victor8730@gmail.com"
    }
  ],
  "config": {
    "platform": {
      "php": "8.3.0"
    },
    "sort-packages": true
  },
  "require": {
    "php": "^8.3",
    "twig/twig": "^3.0",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-mbstring": "*",
    "psr/container": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "WpsMicro\\Core\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "WpsMicro\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "ext-dom": "*",
    "friendsofphp/php-cs-fixer": "^3.0",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.5"
  },
  "scripts": {
    "analyse": "phpstan analyse --configuration=phpstan.neon.dist --no-progress",
    "format": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --sequential",
    "format:check": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff --sequential",
    "quality": [
      "@format:check",
      "@analyse",
      "@test"
    ],
    "test": "phpunit --configuration phpunit.xml.dist",
    "test:coverage": [
      "phpunit --configuration phpunit.xml.dist --coverage-clover build/coverage.xml --coverage-text",
      "@php tools/check-coverage.php build/coverage.xml 70"
    ]
  },
  "archive": {
    "exclude": [
      "**/.DS_Store",
      "/.github/",
      "/.idea/",
      "/.php-cs-fixer.dist.php",
      "/.phpunit.cache/",
      "/phpstan.neon.dist",
      "/composer.lock",
      "/phpunit.xml.dist",
      "/tests/",
      "/tools/",
      "/vendor/"
    ]
  }
}
